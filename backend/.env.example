# AI Configuration
AI_API_KEY=your-api-key-here
AI_API_URL=https://your-api-url.com/v1/models
AI_MODEL=gpt-3.5-turbo

# Security
SECRET_KEY=generate-strong-secret-key-here-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Database
POSTGRES_DSN=postgresql://user:password@localhost:5432/dbname
SQLITE_DATABASE_URI=sqlite+aiosqlite:///./app.db.sqlite3
ENABLE_SQLITE_FALLBACK=true

# CORS Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Sozlution
SMTP_USE_TLS=true

# Generate a strong SECRET_KEY with:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
