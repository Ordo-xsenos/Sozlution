# ======================
# Backend Configuration
# ======================

# Database
POSTGRES_DSN=postgresql://sozlution:sozlution@postgres:5432/sozlution_test
SQLITE_DATABASE_URI=sqlite+aiosqlite:///./app.db.sqlite3
ENABLE_SQLITE_FALLBACK=false

# Security
SECRET_KEY=generate-strong-secret-key-here-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# CORS Origins (JSON array format) - через nginx
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:80","http://nginx"]

# Frontend URL - через nginx
FRONTEND_BASE_URL=http://localhost

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Sozlution
SMTP_USE_TLS=true

# ======================
# Frontend Configuration
# ======================

# Backend API URL (client-side accessible) - через nginx
NEXT_PUBLIC_API_BASE_URL=http://localhost/api

# ======================
# Shared Configuration
# ======================

# AI Chatbot API credentials (used by both frontend and backend)
AI_API_KEY=your-ai-api-key-here
AI_API_URL=https://your-ai-service.com/v1/models
AI_MODEL=gpt-3.5-turbo

# ======================
# Generate SECRET_KEY with:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# ======================
